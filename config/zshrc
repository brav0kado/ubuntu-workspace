# Managed workstation Zsh configuration
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim VISUAL=nvim
HISTFILE="$HOME/.zsh_history"
HISTSIZE=30000
SAVEHIST=30000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt AUTO_CD INTERACTIVE_COMMENTS
umask 022
bindkey -e
bindkey '^[[A' up-line-or-history
bindkey '^[[B' down-line-or-history
autoload -Uz compinit
mkdir -p "$HOME/.cache/zsh"
compinit -d "$HOME/.cache/zsh/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
alias ll='ls -alh --color=auto'
alias la='ls -A --color=auto'
alias v='nvim'
alias ..='cd ..'
command -v batcat >/dev/null && alias bat='batcat'
command -v fdfind >/dev/null && alias fd='fdfind'
[[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# User-installed Go, Rust and Ruby tools
export PATH="$HOME/go/bin:$HOME/.cargo/bin:$PATH"
if command -v ruby >/dev/null; then
  export PATH="$(ruby -r rubygems -e 'puts Gem.user_dir')/bin:$PATH"
fi

# Colourful file listings with icons (Ubuntu Mono + Symbols Nerd Font fallback)
export LS_COLORS='di=1;34:ln=36:ex=1;32:*.zip=35:*.tar=35:*.gz=35:*.png=33:*.jpg=33:*.mp4=35'
if command -v eza >/dev/null; then
  alias ls='eza --icons=auto --color=auto --group-directories-first'
  alias ll='eza -lah --icons=auto --color=auto --group-directories-first'
  alias la='eza -a --icons=auto --color=auto --group-directories-first'
else
  alias ls='ls --color=auto'
fi

# Ctrl+Arrow word navigation in terminals
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
